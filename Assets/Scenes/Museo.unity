      objectReference: {fileID: 0}
    - target: {fileID: 1316328120874871155, guid: 645bb82912ea243e0b90861ff29419ba, type: 3}
      propertyPath: m_text
      value: "Botella Escult\xF3rica\nCultura Moche / Mochica \xB7 100\u2013700 d.C.\nVasija
        zoomorfa que representa una lechuza sentada, modelada con notable expresividad
        en el rostro y el plumaje. Para los Moche, la lechuza era un animal de gran
        carga simb\xF3lica: mensajera del mundo de los muertos, guardiana nocturna
        y figura recurrente en su iconograf\xEDa ritual."
      objectReference: {fileID: 0}
