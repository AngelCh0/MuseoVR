    - target: {fileID: 2440918120509508857, guid: 64a946c1ec12f934bb8d6e5f3aabb1fb, type: 3}
      propertyPath: m_text
      value: "Vaso Ceremonial (Paccha)\nCultura Inca \u2014 1450 d.C. aproximadamente\nVasija
        efigie de cer\xE1mica con forma de pie humano calzando una sandalia tradicional.
        Utilizado en rituales cusque\xF1os para el consumo de chicha de ma\xEDz,
        este recipiente ceremonial cumpl\xEDa un rol clave en la liturgia estatal,
        las ofrendas a la tierra (pago a la Pachamama) y la reciprocidad social."
      objectReference: {fileID: 0}
    - target: {fileID: 2440918120509508857, guid: 64a946c1ec12f934bb8d6e5f3aabb1fb, type: 3}
      propertyPath: m_fontColor.b
