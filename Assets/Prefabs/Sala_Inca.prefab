    - target: {fileID: 2440918120509508857, guid: 64a946c1ec12f934bb8d6e5f3aabb1fb, type: 3}
      propertyPath: m_text
      value: "Momia Chachapoyas-Inca\nCultura Chachapoyas-Inca \u2014 1470 d.C. aproximadamente\nCuerpo
        momificado en posici\xF3n fetal con las manos cubriendo su rostro, un patr\xF3n
        funerario t\xEDpico de la regi\xF3n Amazonas. Tras ser conquistados por el
        Imperio, estas momias combinaron t\xE9cnicas locales e incaicas, siendo protegidas
        en mausoleos en acantilados junto a ofrendas sagradas y quipus."
      objectReference: {fileID: 0}
    - target: {fileID: 2440918120509508857, guid: 64a946c1ec12f934bb8d6e5f3aabb1fb, type: 3}
