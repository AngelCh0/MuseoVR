    - target: {fileID: 2440918120509508857, guid: 64a946c1ec12f934bb8d6e5f3aabb1fb, type: 3}
      propertyPath: m_text
      value: "Botella Escult\xF3rica \u2014 Ser M\xEDtico Acu\xE1tico\nCultura Paracas
        \xB7 800 a.C.\u2013200 d.C.\nVasija que representa una criatura m\xEDtica
        de cuerpo alargado con fauces abiertas, colmillos y ap\xE9ndices en forma
        de aleta o cuerno. La decoraci\xF3n en negro, rojo y crema con l\xEDneas
        de escritura visual Paracas cubre todo el cuerpo. Esta  combinaci\xF3n de
        rasgos de tibur\xF3n, felino y ser sobrenatural, caracter\xEDstica del pante\xF3n
        m\xEDtico de esta cultura."
      objectReference: {fileID: 0}
    - target: {fileID: 2440918120509508857, guid: 64a946c1ec12f934bb8d6e5f3aabb1fb, type: 3}
      propertyPath: m_fontColor.b
