    - target: {fileID: 2669704214623446867, guid: 64a946c1ec12f934bb8d6e5f3aabb1fb, type: 3}
      propertyPath: descripcion
      value: "Huaco Mochica \u2014 Figura Er\xF3tica\nCultura Moche / Mochica \xB7
        100\u2013700 d.C.\nPieza de cer\xE1mica escult\xF3rica caracter\xEDstica
        de la cultura Moche, conocida por su representaci\xF3n expl\xEDcita de la
        sexualidad humana. Los huacos er\xF3ticos mochicas no eran objetos obscenos
        sino artefactos rituales y educativos, vinculados a la fertilidad, la vida
        y la continuidad del ciclo agr\xEDcola."
      objectReference: {fileID: 0}
    - target: {fileID: 5001042639313998470, guid: 64a946c1ec12f934bb8d6e5f3aabb1fb, type: 3}
      propertyPath: m_Name
