    - target: {fileID: 2669704214623446867, guid: 64a946c1ec12f934bb8d6e5f3aabb1fb, type: 3}
      propertyPath: descripcion
      value: "LechuzaBotella Escult\xF3rica\nCultura Moche / Mochica \xB7 100\u2013700
        d.C.\nVasija zoomorfa que representa una lechuza sentada, modelada con notable
        expresividad en el rostro y el plumaje. Para los Moche, la lechuza era un
        animal de gran carga simb\xF3lica: mensajera del mundo de los muertos, guardiana
        nocturna y figura recurrente en su iconograf\xEDa ritual."
      objectReference: {fileID: 0}
    - target: {fileID: 5001042639313998470, guid: 64a946c1ec12f934bb8d6e5f3aabb1fb, type: 3}
      propertyPath: m_Name
